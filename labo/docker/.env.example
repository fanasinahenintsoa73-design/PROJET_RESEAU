# =============================================================================
# Variables du stack Docker — copier en .env et renseigner.
#   cp .env.example .env
# Le fichier .env ne doit JAMAIS etre commite (secrets).
# =============================================================================

# --- Identite du domaine -----------------------------------------------------
MAIL_DOMAIN=meteo-test.lan
MAIL_HOSTNAME=mail.meteo-test.lan
WEB_HOSTNAME=webmail.meteo-test.lan

# --- Ports publies sur la VM -------------------------------------------------
# Decales volontairement : le stack natif garde 25/465/587/143/993/8443.
SMTP_PORT=2525
SUBMISSION_PORT=2587
SMTPS_PORT=2465
IMAP_PORT=1143
IMAPS_PORT=1993
WEB_PORT=8444
ADMIN_PORT=8081

# --- Base de donnees ---------------------------------------------------------
# Mots de passe a remplacer. Aucun ne doit reprendre ceux du serveur natif.
DB_ROOT_PASSWORD=change-me-root
DB_POSTFIXADMIN_PASSWORD=change-me-postfixadmin
DB_ROUNDCUBE_PASSWORD=change-me-roundcube
DB_DOVECOT_PASSWORD=change-me-dovecot

# --- Roundcube ---------------------------------------------------------------
# Cle de chiffrement des sessions : 32 caracteres aleatoires minimum.
#   openssl rand -base64 32
RC_DES_KEY=change-me-32-characters-minimum
