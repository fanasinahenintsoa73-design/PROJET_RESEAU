# =============================================================================
# Connexion SQL de Dovecot — les ${...} sont substitues au demarrage.
# Meme logique que labo/dovecot/dovecot-sql.conf.labo, avec host reseau.
# =============================================================================
driver = mysql
connect = host=${DB_HOST} dbname=${DB_NAME} user=${DB_USER} password=${DB_PASSWORD}
default_pass_scheme = ARGON2ID

password_query = SELECT username AS user, password AS password \
  FROM mailbox WHERE username = '%u' AND active = 1 AND domain = '%d'

user_query = SELECT CONCAT('/var/vmail/', maildir) AS home, 5000 AS uid, 5000 AS gid, \
  CASE WHEN quota IS NULL OR quota <= 0 \
       THEN '*:storage=2048M' \
       ELSE CONCAT('*:storage=', ROUND(quota/1024000), 'M') END AS quota_rule \
  FROM mailbox WHERE username = '%u' AND active = 1 AND domain = '%d'

iterate_query = SELECT username AS user FROM mailbox WHERE domain = '%d' AND active = 1
