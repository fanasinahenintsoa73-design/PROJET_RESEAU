<VirtualHost *:80>
    ServerName postfixadmin.meteo-test.lan
    Redirect permanent / https://postfixadmin.meteo-test.lan/
</VirtualHost>

<VirtualHost *:443>
    ServerName postfixadmin.meteo-test.lan
    DocumentRoot /opt/postfixadmin/public

    # --- TLS : LABO = snakeoil (D1). PROD = Let's Encrypt. -----------------
    SSLEngine on
    SSLCertificateFile    /etc/ssl/certs/ssl-cert-snakeoil.pem
    SSLCertificateKeyFile /etc/ssl/private/ssl-cert-snakeoil.key
    SSLProtocol -all +TLSv1.2 +TLSv1.3

    # --- PHP-FPM : pool DEDIE "postfixadmin", execute sous l'utilisateur ---
    # Unix "pfa" (jamais www-data). Ferme D8.
    <FilesMatch "\.php$">
        SetHandler "proxy:unix:/run/php/php8.1-fpm-postfixadmin.sock|fcgi://localhost"
    </FilesMatch>

    <Directory /opt/postfixadmin/public>
        Options -Indexes +FollowSymLinks
        AllowOverride None
        Require all granted
    </Directory>

    # templates_c DOIT rester inscriptible par PHP (cache Smarty).
    <Directory /opt/postfixadmin/templates_c>
        Require all denied
    </Directory>

    # --- Restriction d'acces (labo) : local + plage NAT de la VM ----------
    # En prod : <Location /> Require ip <PLAGE_LAN_DGM> ... (voir
    # labo/prod/apache/21-postfixadmin-interne.conf).
    <Location />
        Require ip 127.0.0.1
        Require ip 10.0.2.0/24
    </Location>

    ErrorLog /var/log/apache2/postfixadmin_error.log
    CustomLog /var/log/apache2/postfixadmin_access.log combined
</VirtualHost>
