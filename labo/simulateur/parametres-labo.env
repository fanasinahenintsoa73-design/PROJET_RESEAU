# =============================================================================
# PARAMETRES LABO - equivalents de labo/prod/parametres-prod.env
# -----------------------------------------------------------------------------
# Meme fichier de parametres, valeurs du labo : le script 21 s'execute donc
# a l'identique en labo et en production. Ce qui est valide en labo l'est
# en prod (memes gabarits, meme mecanique de deploiement).
#
# Le "Portail" du labo est le simulateur Apache qui ecoute sur 8444 et relaie
# vers le vhost interne 8080 : vu de Roundcube, il vient de 127.0.0.1, d'ou
# IP_PORTAIL=127.0.0.1.
# =============================================================================

HOSTNAME_WEBMAIL=webmail.meteomadagascar.mg
HOSTNAME_POSTFIXADMIN=postfixadmin.meteomadagascar.mg

# Simulateur du Portail : loopback.
IP_PORTAIL=127.0.0.1

# Reseau autorise a joindre la console d'administration.
# 10.0.2.0/24 = plage NAT de la VM de labo (equivalent du LAN de la DGM).
PLAGE_LAN_DGM=10.0.2.0/24

# Adresse de la VM de labo (equivalent de l'IP privee du serveur de messagerie).
IP_MAIL_PRIVEE=10.0.2.15
IP_MAIL_PUBLIQUE=41.207.49.27

# Nom annonce au serveur SMTP (HELO).
HOSTNAME_SMTP=meteo-test.lan

# Compte utilise par le test de connexion de bout en bout a travers le
# simulateur du reverse-proxy. Le mot de passe est lu dans
# /root/labo-credentials.txt (jamais en clair dans le depot).
LOGIN_TEST=tiana.rakoto@meteo-test.lan
