# =============================================================================
# Dovecot - configuration LABORATOIRE
# Fichier : /etc/dovecot/dovecot.conf
# Labo : meteo-test.lan   |   Prod : meteomadagascar.mg (meme structure)
# =============================================================================

# ManageSieve : gestion des filtres par les clients (Thunderbird, Roundcube).
# Port 4190 — celui qu'on oublie toujours dans le plan deifenetrage MikroTik.
service managesieve-login {
  inet_listener sieve {
    port = 4190
  }
  service_count = 1
  process_min_avail = 0
}

service managesieve {
  process_limit = 1024
}

# NOTE : `sieve` n'est PAS un protocole IMAP. C'est ManageSieve, exigeant le
# paquet dovecot-managesieved (distinct de dovecot-sieve, qui est le plugin de
# filtrage LMTP). Sans ce paquet, dovecot refuse de demarrer avec
# "protocols: Unknown protocol: sieve".
protocols = imap lmtp sieve

# --- Chiffrement : TLS des la connexion (IMAP 993) --------------------------
ssl = required
ssl_cert = </etc/ssl/certs/ssl-cert-snakeoil.pem
ssl_key = </etc/ssl/private/ssl-cert-snakeoil.key
ssl_min_protocol = TLSv1.2
ssl_prefer_server_ciphers = yes
ssl_cipher_list = ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305:ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256

# --- Authentification -------------------------------------------------------
# BARRIERE 4 : anti-bruteforce. 5 essais puis blocage de l'IP pendant 15 min.
auth_mechanisms = plain login
auth_username_format = %Lu
auth_verbose = yes

# Socket SASL pour Postfix (authentification SMTP sur le port 587).
# PIEGE Dovecot 2.3 : le `service auth` par defaut contient DEJA un
# `unix_listener auth-client` (nom relatif, resolu vers
# /var/run/dovecot/auth-client). Si on declare le chemin ABSOLU, Dovecot voit
# DEUX listeners sur le meme fichier et refuse de demarrer avec
# "service(auth): Socket already exists". On DOIT donc reutiliser le nom
# relatif `auth-client` pour SURCHARGER le defaut, pas le dupliquer.
service auth {
  unix_listener auth-userdb {
    mode = 0600
    user = vmail
  }
  unix_listener auth-client {
    mode = 0660
    user = postfix
    group = postfix
  }
}

passdb {
  driver = sql
  args = /etc/dovecot/dovecot-sql.conf
}
userdb {
  driver = sql
  args = /etc/dovecot/dovecot-sql.conf
}

# --- Fichiers et repertoires ------------------------------------------------
mail_location = maildir:/var/vmail/%d/%n
mail_uid = vmail
mail_gid = vmail
mail_home = /var/vmail/%d/%n
mail_privileged_group = mail
first_valid_uid = 100
mail_plugins = $mail_plugins quota

# PIEGE DOVECOT 2.3 (Ubuntu 22.04) : `sieve` ne doit JAMAIS etre charge
# globalement. Le plugin sieve (lib90_sieve_plugin.so) reference des symboles
# LDA (mail_deliver_ctx_get_log_var_expand_table) qui n'existent pas dans le
# contexte `doveadm`. Resultat : `doveadm pw` (utilise par PostfixAdmin pour
# hacher les mots de passe) echoue avec "undefined symbol", et AUCUN compte
# ne peut etre cree. On ne charge sieve que dans LMTP, la ou le filtrage a
# lieu reellement.
protocol lmtp {
  mail_plugins = $mail_plugins sieve
}

# --- Quotas (appliques par Dovecot, PAS par Postfix) -----------------------
# NOTE VERSION : sur Dovecot 2.3.16 (Ubuntu 22.04), les reglages de quota se
# declarent DANS un bloc plugin { }. La syntaxe `quota = Mailbox` est reservee
# a Dovecot 2.4 et fait echouer la config avec "Unknown setting: quota".
# Le plugin quota n'est PAS un paquet separe : c'est /usr/lib/dovecot/modules/
# lib10_quota_plugin.so, charge par mail_plugins ci-dessus.
#
# En overflow la boite est gardee 5 jours le temps que l'agent trie :
# personne ne perd de courrier.
plugin {
  quota = maildir:User quota
  quota_rule = *:storage=2G
  quota_rule2 = Trash:storage=+200M
  # PIEGE : quota_grace n'accepte PAS '5d' ("Unknown unit: d" -> la session
  # IMAP meurt juste APRES un login reussi). Duree en SECONDES : 5 j = 432000.
  quota_grace = 432000
  quota_warning = storage=90%% quota-warning 90 %u
  quota_warning2 = storage=100%% quota-warning 100 %u
  quota_status_success = DUNNO
  quota_status_nouser = DUNNO
  quota_status_overquota = "552 5.2.2 Boite en exces de quota"
}

# --- Sieve (filtres cote serveur, survives au webmail) ----------------------
plugin {
  # Filtres cote serveur : ils survivent au webmail et a un changement de client.
  sieve = ~/.dovecot.sieve
  sieve_global_path = /var/lib/dovecot/sieve/global
  sieve_max_script_size = 1M
}

# --- Logs -------------------------------------------------------------------
log_path = /var/log/dovecot.log
info_log_path = /var/log/dovecot.log
debug_log_path = /var/log/dovecot.log
auth_failure_delay = 2 secs
auth_verbose_passwords = no
login_trusted_networks = 127.0.0.0/8, 10.0.2.0/24

service imap-login {
  inet_listener imap {
    port = 143
  }
  inet_listener imaps {
    port = 993
    ssl = yes
  }
  service_count = 1
  process_min_avail = 2
}

namespace inbox {
  inbox = yes
  separator = /
  mailbox Sent {
    auto = subscribe
    special_use = \Sent
  }
  mailbox Trash {
    auto = subscribe
    special_use = \Trash
  }
  mailbox Drafts {
    auto = subscribe
    special_use = \Drafts
  }
  mailbox Junk {
    auto = subscribe
    special_use = \Junk
  }
}