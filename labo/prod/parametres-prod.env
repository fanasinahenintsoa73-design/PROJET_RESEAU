# =============================================================================
# PARAMETRES DE PRODUCTION - a remplir au moment du deploiement reel
# -----------------------------------------------------------------------------
# Ce fichier est lu par labo/scripts/21-deploy-prod-web.sh.
# Les valeurs ci-dessous sont des EXEMPLES : les trois premieres lignes
# doivent etre confirmees aupres de l'encadrant (qui fait les demandes
# aupres du Portail et de YAS).
#
# Rappel de la topologie reelle (verifiee le 21 octobre 2026) :
#   - 41.207.49.27  : IP fixe YAS du serveur mail. Le port 443 y est DEJA
#                     tenu par le nginx du Portail (il sert adl.meteomadagascar.mg).
#   - 102.16.63.110 : site meteomadagascar.mg (Cloudflare), independant.
#   - DNS : zone chez Stellarix. Le Portail Meteo cree des VHOSTS NGINX,
#           pas des enregistrements DNS.
# =============================================================================

# --- Identite des sous-domaines ----------------------------------------------
HOSTNAME_WEBMAIL=webmail.meteomadagascar.mg
HOSTNAME_POSTFIXADMIN=postfixadmin.meteomadagascar.mg

# --- IP du Portail Meteo (serveur nginx qui porte adl. et reverse-proxy) -----
# A determiner par l'encadrant. C'est cette IP qui doit figurer dans
# $config['proxy_whitelist'] de Roundcube : sans elle, Roundcube ignore les
# en-tetes X-Forwarded-* et genere des URL en http://...:8080 (mixed content).
IP_PORTAIL=192.168.1.10

# --- Reseau interne de la Direction Generale (autorise sur PostfixAdmin) ----
# PostfixAdmin n'est accessible QUE depuis ce reseau.
PLAGE_LAN_DGM=192.168.1.0/24

# --- Adresse du serveur de messagerie ----------------------------------------
# ipCible a saisir dans le Portail pour le sous-domaine webmail :
#   - si le Portail est sur le LAN de la DGM  -> IP_MAIL_PRIVEE (recommande)
#   - si le Portail est hors LAN              -> IP_MAIL_PUBLIQUE
IP_MAIL_PRIVEE=192.168.1.20
IP_MAIL_PUBLIQUE=41.207.49.27

# Nom annonce au serveur SMTP (HELO).
HOSTNAME_SMTP=mail.meteomadagascar.mg

# Compte de test utilise par le test de connexion de bout en bout a travers
# le reverse-proxy. VIDE en production tant que le compte pilote n'existe pas
# (le test est alors ignore, pas en erreur).
LOGIN_TEST=
